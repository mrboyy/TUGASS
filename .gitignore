```
# Dependency directories
/vendor/
/node_modules/

# Laravel-specific
/bootstrap/cache/
/storage/framework/cache/
/storage/framework/sessions/
/storage/framework/views/
/storage/logs/
/database/seeders/
/database/factories/

# Environment variables
.env
.env.local
.env.*

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log

# Compiled files
*.php~
*.js~
*.css~

# Coverage reports
coverage/
htmlcov/
.coverage

# Build artifacts
dist/
build/
target/

# Python cache (if any Python files exist in project)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
```